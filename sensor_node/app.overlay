/ {
    soil1: soil {
        compatible = "csse4011,soil";
        status = "okay";
    };

    /* Water pump on D1 (P0.03) — driven HIGH to turn on */
    pump_ctrl {
        compatible = "gpio-leds";
        pump0: pump_0 {
            gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
            label = "Water Pump";
        };
    };

    aliases {
        pump0 = &pump0;
    };
};

&i2c1 {
    status = "okay";

    /* SHT30 — temperature + humidity (Zephyr built-in driver) */
    sht30: sht3xd@44 {
        compatible = "sensirion,sht3xd";
        reg = <0x44>;
    };

    /* QMP6988 — barometric pressure (custom driver) */
    qmp6988: qmp6988@70 {
        compatible = "csse4011,qmp6988";
        reg = <0x70>;
    };
};